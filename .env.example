# =========================================================
# GREEN HARVEST - ENVIRONMENT VARIABLES EXAMPLE
# =========================================================
#
# Copy this file to .env only for local configuration if your
# environment loader supports it.
#
# NEVER commit the real .env file to GitHub.
# NEVER place real passwords, AWS access keys, or secrets here.
# =========================================================


# ---------------------------------------------------------
# Application
# ---------------------------------------------------------

APP_ENV=local
APP_URL=http://localhost/Green_harvest

SESSION_SECURE=0
SESSION_DOMAIN=
SESSION_SAME_SITE=Lax


# ---------------------------------------------------------
# Database
# ---------------------------------------------------------

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=green_harvest
DB_USER=root
DB_PASS=


# ---------------------------------------------------------
# Contact / Application Email
# ---------------------------------------------------------

CONTACT_EMAIL=hello@example.com


# ---------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/Green_harvest/google-callback.php


# ---------------------------------------------------------
# AWS / Amazon S3
# ---------------------------------------------------------
#
# On EC2, prefer an IAM role instead of storing AWS access keys.
# The application will use these values when S3 integration is added.
# ---------------------------------------------------------

AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_BASE_URL=

# Do not add AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY
# to the repository. Use an IAM role on EC2.


# ---------------------------------------------------------
# Production Example
# ---------------------------------------------------------
#
# APP_ENV=production
# APP_URL=https://your-domain.example
# SESSION_SECURE=1
#
# DB_HOST=your-rds-endpoint.amazonaws.com
# DB_PORT=3306
# DB_NAME=green_harvest
# DB_USER=your_database_user
# DB_PASS=your_database_password
#
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-green-harvest-bucket
